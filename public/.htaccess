# Routage de l'application React (BrowserRouter) : toute URL qui ne correspond
# pas a un fichier ou dossier reel est servie par index.html.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Secours si mod_rewrite est indisponible
ErrorDocument 404 /index.html
